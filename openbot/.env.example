# Pier 15 Concierge — AG-UI bot endpoint
# Copy to .env and adjust. Every value has a working default for local use.

PORT=8787
HOST=0.0.0.0

# Origin allowed to call the endpoint from a browser.
# Use the exact origin that serves the prototype, or * for local demos only.
ALLOWED_ORIGIN=*

# Milliseconds between streamed text chunks (0 disables the typing effect).
STREAM_DELAY_MS=12

# Serve the standalone prototype from the same origin (solves CORS entirely).
# 1 = on, 0 = off. When on, GET / serves index.html from the project root.
EXPLORATORIUM_STATIC=1
EXPLORATORIUM_STATIC_DIR=

# Path to the knowledge base (defaults to openbot/kb/knowledge.json).
EXPLORATORIUM_KB=
